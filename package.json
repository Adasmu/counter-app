{
  "name": "counter-app",
  "version": "1.0.0",
  "private": true,
  "description": "AP5PM CounterApp - CV02, CV03 a CV04",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "ng": "ng",
    "start": "ionic serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.{json,mjs,ts,md}\" \"scripts/**/*.mjs\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"*.{json,mjs,ts,md}\" \"scripts/**/*.mjs\" --no-error-on-unmatched-pattern",
    "check": "npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@angular/common": "~22.0.1",
    "@angular/compiler": "~22.0.1",
    "@angular/core": "~22.0.1",
    "@angular/forms": "~22.0.1",
    "@angular/platform-browser": "~22.0.1",
    "@angular/router": "~22.0.1",
    "@capacitor/core": "^8.5.0",
    "@ionic/angular": "~9.0.0",
    "ionicons": "^8.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "@capacitor/preferences": "^8.0.0"
  },
  "devDependencies": {
    "@angular/build": "~22.0.1",
    "@angular/cli": "~22.0.1",
    "@angular/compiler-cli": "~22.0.1",
    "@angular-eslint/builder": "~22.0.0",
    "angular-eslint": "~22.0.0",
    "@capacitor/cli": "^8.5.0",
    "@ionic/cli": "7.2.1",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.62.1",
    "typescript": "~6.0.0",
    "vitest": "^4.1.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0"
  }
}
